{
  "comment": "Each case copies a valid fixture record (base), changes its id to <base>-bad unless 'set' gives an id, applies 'set' and 'unset', and adds it to data/<kind>/zz-bad.json. The build must fail with 'expect' in its errors.",
  "cases": [
    {"rule": "type", "base": "tool:remotion-dev/remotion", "set": {"title": 5}, "category": "invalid",
     "expect": "title: expected string, got integer"},
    {"rule": "required", "base": "tool:remotion-dev/remotion", "unset": ["summary"], "category": "invalid",
     "expect": "summary: missing required field"},
    {"rule": "enum", "base": "tool:remotion-dev/remotion", "set": {"fit": "great"}, "category": "invalid",
     "expect": "fit: 'great' is not one of"},
    {"rule": "pattern", "base": "tool:remotion-dev/remotion", "set": {"url": "ftp://example.com"}, "category": "invalid",
     "expect": "url: 'ftp://example.com' does not match"},
    {"rule": "additionalProperties", "base": "tool:remotion-dev/remotion", "set": {"stars": 5}, "category": "invalid",
     "expect": "stars: unknown field"},
    {"rule": "items", "base": "tool:remotion-dev/remotion", "set": {"agents": ["claude-code", "vim"]}, "category": "invalid",
     "expect": "agents[1]: 'vim' is not one of"},
    {"rule": "nested required", "base": "tool:remotion-dev/remotion",
     "set": {"claims": [{"text": "t", "quote": "q", "url": "https://example.com", "retrieved": "2026-11-01"}]},
     "category": "invalid", "expect": "claims[0].locator: missing required field"},
    {"rule": "kind conditional (tool)", "base": "tool:remotion-dev/remotion", "unset": ["tool_type"], "category": "invalid",
     "expect": "tool_type: missing required field"},
    {"rule": "kind conditional (model)", "base": "model:example/wan-video", "unset": ["access"], "category": "invalid",
     "expect": "access: missing required field"},
    {"rule": "kind conditional (recipe)", "base": "recipe:remotion-explainer", "unset": ["stages"], "category": "invalid",
     "expect": "stages: missing required field"},
    {"rule": "rel fixed list", "base": "tool:remotion-dev/remotion",
     "set": {"related": [{"id": "tool:heygen-com/hyperframes", "rel": "likes"}]}, "category": "invalid",
     "expect": "related[0].rel: 'likes' is not one of"},
    {"rule": "slug", "base": "tool:remotion-dev/remotion", "set": {"id": "tool:Bad_Slug"}, "category": "invalid",
     "expect": "slug 'Bad_Slug' does not match"},
    {"rule": "slug double underscore", "base": "tool:remotion-dev/remotion", "set": {"id": "tool:a__b"}, "category": "invalid",
     "expect": "slug must not contain //, __ or end with /"},
    {"rule": "kind prefix vs folder", "base": "tool:remotion-dev/remotion", "set": {"id": "model:in-tool-folder"},
     "category": "invalid", "expect": "does not match folder data/tool/"},
    {"rule": "duplicate id", "base": "tool:remotion-dev/remotion", "set": {"id": "tool:remotion-dev/remotion"},
     "category": "invalid", "expect": "duplicate id, first in data/tool/fixture-lane.json"},
    {"rule": "calendar date", "base": "tool:remotion-dev/remotion",
     "set": {"checked": {"date": "2026-11-01", "depth": "skim", "by": "agent:x", "next_due": "2026-02-30"}},
     "category": "invalid", "expect": "checked.next_due: '2026-02-30' is not a calendar date"},
    {"rule": "next_due before date", "base": "tool:remotion-dev/remotion",
     "set": {"checked": {"date": "2026-11-01", "depth": "skim", "by": "agent:x", "next_due": "2026-01-01"}},
     "category": "invalid", "expect": "checked.next_due: is before checked.date"},
    {"rule": "dangling related", "base": "tool:remotion-dev/remotion",
     "set": {"related": [{"id": "tool:nobody/missing", "rel": "depends_on"}]}, "category": "dangling",
     "expect": "related[0].id: no record tool:nobody/missing"},
    {"rule": "dangling superseded_by", "base": "tool:remotion-dev/remotion", "set": {"superseded_by": "tool:nobody/gone"},
     "category": "dangling", "expect": "superseded_by: no record tool:nobody/gone"},
    {"rule": "dangling stage", "base": "recipe:remotion-explainer",
     "set": {"stages": [{"stage": "render", "record_id": "model:nobody/missing"}]}, "category": "dangling",
     "expect": "stages[0].record_id: no record model:nobody/missing"},
    {"rule": "unknown concept", "base": "tool:remotion-dev/remotion", "set": {"concepts": ["concept:not-in-vocabulary"]},
     "category": "bad concept", "expect": "concepts[0]: unknown concept concept:not-in-vocabulary"}
  ]
}
