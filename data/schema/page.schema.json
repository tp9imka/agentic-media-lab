{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page.schema.json",
  "title": "Page frontmatter",
  "description": "Frontmatter between --- lines at the top of every markdown file under docs/.",
  "type": "object",
  "required": ["id", "title", "summary", "use_when", "concepts", "last_reviewed"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^guide:[a-z0-9][a-z0-9._/-]*$", "description": "Stable, never reused."},
    "title": {"type": "string"},
    "summary": {"type": "string", "description": "One sentence."},
    "use_when": {"type": "string", "pattern": "^Use this page when ", "description": "Feeds llms.txt and the AGENTS.md route index."},
    "concepts": {"type": "array", "items": {"type": "string", "pattern": "^concept:[a-z0-9][a-z0-9-]*$"}},
    "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
